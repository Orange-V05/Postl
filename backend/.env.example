# POSTL Backend Environment Variables
# Copy to backend/.env for local development. Do not commit real secrets.

NODE_ENV=development
PORT=4000

# Required when credentials=true. Comma-separated exact origins.
ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# Firebase Admin. Use one of these. Production must configure Firebase Admin.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI provider selection. Provider names: ollama, openrouter, huggingface.
# Production default is OpenRouter. Development default is Ollama when AI_PRIMARY_PROVIDER is empty.
AI_PRIMARY_PROVIDER=
AI_FALLBACK_PROVIDERS=openrouter,huggingface,ollama
# Optional comma-separated friendly POSTL model IDs to expose. Leave empty for enabled defaults.
# Example: balanced-cloud,local-gemma,economy-hf
AI_MODELS=

# Ollama requires a persistent host. Not suitable for ordinary short-lived serverless functions.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma-4:e2b

# Cloud fallback providers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_FREE_MODELS=google/gemma-3-27b-it:free
ALLOW_PAID_AI_MODELS=false
OPENROUTER_HTTP_REFERER=https://postl.vercel.app
OPENROUTER_APP_TITLE=POSTL Content Intelligence
HF_TOKEN=
HF_MODEL=google/gemma-2b-it

# Reliability and limits.
CACHE_TTL_MS=3600000
CACHE_MAX_ITEMS=200
PROVIDER_TIMEOUT_MS=45000
PROVIDER_CONCURRENCY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
USER_DAILY_GENERATION_LIMIT=25
USER_DAILY_REPURPOSE_LIMIT=10
