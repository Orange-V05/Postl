# POSTL Backend Environment Variables
# Copy to backend/.env for local development. Do not commit real secrets.

NODE_ENV=development
PORT=4000

# Required when credentials=true. Comma-separated exact origins.
ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# Firebase Admin. Use one of these. Production must configure Firebase Admin.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# AI provider selection. Provider names: ollama, openrouter, huggingface.
AI_PRIMARY_PROVIDER=ollama
AI_FALLBACK_PROVIDERS=openrouter,huggingface

# Ollama requires a persistent host. Not suitable for ordinary short-lived serverless functions.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma-4:e2b

# Cloud fallback providers.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
HF_TOKEN=
HF_MODEL=google/gemma-2b-it

# Reliability and limits.
CACHE_TTL_MS=3600000
CACHE_MAX_ITEMS=200
PROVIDER_TIMEOUT_MS=45000
PROVIDER_CONCURRENCY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
