{
  "name": "postl-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/server.js",
    "start:legacy-local-ai": "python LocalAIServer/server.py",
    "check": "node scripts/check-js-syntax.js",
    "config:check": "node scripts/config-check.js",
    "smoke:import": "node -e \"import('./src/app.js').then(() => console.log('app import ok'))\"",
    "build": "npm run check && npm run config:check && npm run smoke:import"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "joi": "^18.1.1",
    "serverless-http": "^4.0.0"
  }
}
